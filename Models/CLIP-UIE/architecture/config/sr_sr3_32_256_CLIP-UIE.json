{
  "model": {
    "which_model_G": "sr3",
    "finetune_norm": false,
    "unet": {
      "in_channel": 6,
      "out_channel": 3,
      "inner_channel": 64,
      "channel_multiplier": [
        1,
        2,
        4,
        8,
        8
      ],
      "attn_res": [
        16
      ],
      "res_blocks": 2,
      "dropout": 0.2
    },
    "beta_schedule": {
      "train": {
        "schedule": "linear",
        "n_timestep": 2000,
        "linear_start": 1e-06,
        "linear_end": 0.01
      },
      "val": {
        "schedule": "linear",
        "n_timestep": 2000,
        "linear_start": 1e-06,
        "linear_end": 0.01
      }
    },
    "diffusion": {
      "image_size": 256,
      "channels": 3,
      "conditional": true
    }
  }
}
